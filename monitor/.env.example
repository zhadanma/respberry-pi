# 监控端配置示例
# 复制为 .env 后填写真实值 —— 切勿把 .env 提交到仓库，也不要把真实凭据写进代码。

# 设备标识
DEVICE_ID=monitor-01

# PC 端服务地址（开发阶段：同一局域网）
PC_BASE_URL=http://127.0.0.1:8080

# 上报鉴权令牌（与 PC 端 application.properties 的 app.api-token 一致）
API_TOKEN=change-me

# 邮件（SMTP）—— P5 使用；使用邮箱「授权码」，不要用登录密码
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_account@example.com
SMTP_AUTH_CODE=your_app_password
MAIL_TO=family@example.com

# 摄像头：开发期 PC 用 opencv（设备号），部署期树莓派用 picamera2（CSI）
CAMERA_BACKEND=opencv
CAMERA_INDEX=0

# 视频推流参数（MJPEG）
VIDEO_WIDTH=640
VIDEO_HEIGHT=480
VIDEO_FPS=10
VIDEO_JPEG_QUALITY=70

# 推流服务监听地址（PC 端从这里拉流）
MONITOR_HOST=0.0.0.0
MONITOR_PORT=8000

# 配置轮询周期（秒）与 HTTP 超时（秒）
CONFIG_POLL_SECONDS=10
HTTP_TIMEOUT_SECONDS=5

# 音频采集（P3 使用）；留空表示系统默认输入设备
AUDIO_SAMPLE_RATE=16000
AUDIO_DEVICE=
